summary: Build and run a bootc VM for testing
tag: dnf

provision:
  how: virtual
  # Can be overridden with `tmt ... -image $URL` or via Packit's `tf_extra_params`
  image: https://cloud.centos.org/centos/10-stream/x86_64/images/CentOS-Stream-GenericCloud-10-latest.x86_64.qcow2

prepare:
- how: install
  package:
  - podman
  - skopeo
  - jq

execute:
  how: tmt

/test-01-transient:
  summary: Test DNF transient mode (--transient, persistence=transient)
  discover:
    how: fmf
    test:
    - /tmt/tests/test-00-bootc-install
    - /tmt/tests/test-01-transient
